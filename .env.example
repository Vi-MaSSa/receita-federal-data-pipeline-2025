# ========================
# Receita Federal 2025 Pipeline — Environment Configuration
# ========================
#
# Copy this file to .env and configure for your environment.
# NEVER commit actual secrets — only use placeholders.
#

# Runtime Environment
ENV=local
# ENV=aws  (for production on EC2)

# AWS Configuration (if ENV=aws)
AWS_REGION=sa-east-1
# AWS_ACCESS_KEY_ID=your-access-key-here      (prefer IAM role in EC2)
# AWS_SECRET_ACCESS_KEY=your-secret-key-here  (prefer IAM role in EC2)

# S3 Data Lake Configuration
S3_BUCKET=your-bucket-name
# Default fallback: datalake-receita-federal-massagardi

# Data Lake Paths (configure if using custom bucket)
RAW_BASE=raw/receita_federal/estabelecimentos
SILVER_BASE=silver/receita_federal/estabelecimentos
GOLD_BASE=gold/receita_federal/estabelecimentos

# Local Data Paths
LOCAL_DATA_DIR=data
LOCAL_OUTPUT_DIR=output

# Date Parameters (for filtering)
YEAR=2025
MONTH=01

# Optional: MotherDuck Cloud Analytics (for DuckDB hybrid cloud)
# Leave empty for local DuckDB :memory:
MOTHERDUCK_TOKEN=your-token-here

# DuckDB Configuration
DUCKDB_TEMP_DIR=.tmp_duckdb
DUCKDB_MAX_MEMORY=8GB
DUCKDB_THREADS=4

# Logging
LOG_LEVEL=INFO
# LOG_LEVEL=DEBUG  (for troubleshooting)
